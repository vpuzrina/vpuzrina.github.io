---
import BaseLayout from './BaseLayout.astro';
import ContextLine from '../components/ContextLine.astro';
import Provenance from '../components/Provenance.astro';
import { u, fmtDate } from '../lib/url';

interface Props {
  title: string;
  description: string;
  context: string[];
  provenance: { repo: string; data: string; stack: string; status: string };
  updated: Date;
}
const { title, description, context, provenance, updated } = Astro.props;
// keep number ranges like 300–600 on one line (word joiner after the en dash)
const h1 = title.replace(/(\d)–(\d)/g, '$1–\u2060$2');
---
<BaseLayout title={title} description={description}>
  <article class="wrap paper">
    <header class="paper-head prose">
      <h1>{h1}</h1>
      <ContextLine items={context} />
    </header>
    <div class="paper-body">
      <slot />
    </div>
    <section class="section" aria-labelledby="prov-title">
      <h2 id="prov-title" class="label">Provenance</h2>
      <Provenance items={[['repo', provenance.repo], ['data', provenance.data], ['stack', provenance.stack], ['status', provenance.status], ['updated', fmtDate(updated)]]} />
    </section>
    <p class="more back no-print"><a href={u('/#contents')}>← Contents</a></p>
  </article>
</BaseLayout>
<style>
  .paper-head { padding: var(--space-5) 0 var(--space-3); }
  .paper-head h1 { font-size: clamp(1.75rem, 1.3rem + 2vw, 2.4rem); margin-bottom: var(--space-2); }
  .paper-body > :global(p), .paper-body > :global(ul), .paper-body > :global(ol), .paper-body > :global(h2) { max-width: var(--measure); }
  .paper-body > :global(h2) { margin: var(--space-4) 0 var(--space-2); padding-top: var(--space-3); border-top: 1px solid var(--rule); }
  .paper-body > :global(p:first-child) { font-size: 1.08em; }
  .paper-body > :global(h3) { margin: var(--space-3) 0 var(--space-1); max-width: var(--measure); }
  .paper-body :global(ul:not([class])) { padding-left: 1.2rem; }
  .paper-body :global(ul:not([class]) li) { margin-bottom: 0.45rem; }
  .paper-body :global(.table-label) { margin: var(--space-3) 0 0.5rem; }
  .paper-body > :global(table) {
    border-collapse: collapse;
    width: 100%;
    max-width: var(--measure);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }
  .paper-body > :global(table) :global(th), .paper-body > :global(table) :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.45rem 1rem 0.45rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .paper-body > :global(table) :global(thead th) {
    font-family: var(--mono);
    font-size: var(--fs-label);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    border-bottom-color: var(--muted);
  }
  .paper-body > :global(table) :global(td:first-child) { font-family: var(--mono); font-size: var(--fs-mono); white-space: nowrap; }
  .paper-body :global(.note) { color: var(--muted); font-size: var(--fs-small); }
  .back { margin-top: var(--space-2); }
  .section > h2.label { margin-bottom: var(--space-2); font-size: var(--fs-label); }
</style>
