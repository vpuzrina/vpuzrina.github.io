---
// "light / dark" text button. Hidden without JS (the page then follows the system setting).
// The accessible name contains the visible text ("Theme: light / dark, now dark"), so voice control works.
---
<button class="theme-toggle mono" type="button">
  <span class="visually-hidden">Theme: </span><span data-t="light">light</span> / <span data-t="dark">dark</span><span class="visually-hidden">, now <span data-cur>dark</span></span>
</button>

<script is:inline>
  (function () {
    var b = document.querySelector('.theme-toggle');
    if (!b) return;
    var d = document.documentElement;
    var cur = b.querySelector('[data-cur]');
    function sync() { cur.textContent = d.dataset.theme; }
    b.addEventListener('click', function () {
      var t = d.dataset.theme === 'dark' ? 'light' : 'dark';
      d.dataset.theme = t;
      try { localStorage.setItem('theme', t); } catch (e) {}
      sync();
    });
    sync();
  })();
</script>

<style>
  .theme-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 0.3rem 0;
    margin: -0.3rem 0;
    min-height: 24px;
    font-size: var(--fs-mono);
    color: var(--muted);
    cursor: pointer;
  }
  :global(.js) .theme-toggle { display: inline-block; }
  .theme-toggle:hover { color: var(--accent); }
  :global([data-theme='light']) .theme-toggle [data-t='light'],
  :global([data-theme='dark']) .theme-toggle [data-t='dark'] {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
