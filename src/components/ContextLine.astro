---
// type · dates · data · tools · status, in mono
import Text from './Text.astro';
interface Props { items: string[]; class?: string }
const { items, class: cls } = Astro.props;
---
<p class:list={['context mono muted', cls]}>
  {items.map((it, i) => (<>{i > 0 && <span aria-hidden="true"> · </span>}<Text s={it} /></>))}
</p>
<style>
  .context { margin: 0; }
</style>
