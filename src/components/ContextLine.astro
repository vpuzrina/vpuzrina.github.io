---
// type · dates · data · tools · status, in mono
import { stripTodo } from '../lib/url';
interface Props { items: string[]; class?: string }
const { items: raw, class: cls } = Astro.props;
const items = raw.map(stripTodo).filter(Boolean);
---
<p class:list={['context mono muted', cls]}>
  {items.map((it, i) => (<>{i > 0 && <span aria-hidden="true"> · </span>}{it}</>))}
</p>
<style>
  .context { margin: 0; }
</style>
