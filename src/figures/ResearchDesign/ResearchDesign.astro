---
// Schematic of the NIL / marketability research design. No numbers until the data is in.
// HTML rather than SVG so it reflows on a phone; the arrows are drawn with borders.
---
<div class="rd" role="group" aria-label="Research design: on-court performance predicts Instagram followers; the question is whether the relationship differs for women and men, holding other factors fixed.">
  <div class="box x">
    <span class="k mono">explanatory</span>
    <span>On-court performance</span>
    <span class="d mono">season statistics</span>
  </div>
  <div class="arrow main" aria-hidden="true"><span class="mono">predicts</span></div>
  <div class="box y">
    <span class="k mono">outcome</span>
    <span>Instagram followers</span>
    <span class="d mono">measure of marketability</span>
  </div>
  <div class="mod">
    <div class="up" aria-hidden="true"></div>
    <div class="box g">
      <span class="k mono">the question</span>
      <span>Gender</span>
      <span class="d mono">same stats, different audience?</span>
    </div>
  </div>
  <div class="box z">
    <span class="k mono">held fixed</span>
    <span>Other factors</span>
    <span class="d mono"><mark class="todo">[TODO: controls]</mark></span>
  </div>
  <div class="dash" aria-hidden="true"></div>
</div>

<style>
  .rd {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 8rem minmax(0, 1fr);
    grid-template-areas:
      'x arrow y'
      '. mod dash'
      '. . z';
    align-items: center;
    max-width: 44rem;
    row-gap: 0;
  }
  .box {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    border: 1px solid var(--rule);
    background: var(--surface);
    padding: 0.6rem 0.8rem;
    font-size: var(--fs-small);
    line-height: 1.35;
  }
  .k { font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .d { font-size: var(--fs-label); color: var(--muted); }
  .x { grid-area: x; }
  .y { grid-area: y; border-color: var(--muted); }
  .z { grid-area: z; border-style: dashed; background: transparent; }
  .arrow {
    grid-area: arrow;
    position: relative;
    height: 2.5rem;
    display: grid;
    place-items: start center;
  }
  .arrow::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    right: 0.5rem;
    top: 50%;
    border-top: 1px solid var(--text);
  }
  .arrow::after {
    content: '';
    position: absolute;
    right: 0.25rem;
    top: calc(50% - 4px);
    border: 4px solid transparent;
    border-left: 7px solid var(--text);
    border-right: 0;
  }
  .arrow span { font-size: var(--fs-label); color: var(--muted); }
  .mod { grid-area: mod; display: flex; flex-direction: column; align-items: center; margin-top: -1.25rem; margin-bottom: 1rem; }
  .up { height: 1.6rem; border-left: 1px dashed var(--muted); position: relative; }
  .up::before {
    content: '';
    position: absolute;
    left: -4.5px;
    top: -1px;
    border: 4px solid transparent;
    border-bottom: 7px solid var(--muted);
    border-top: 0;
  }
  .g { width: 11rem; border-color: var(--muted); text-align: center; }
  .dash {
    grid-area: dash;
    justify-self: center;
    height: 100%;
    min-height: 3rem;
    border-left: 1px dashed var(--muted);
  }
  @media (max-width: 640px) {
    .rd {
      grid-template-columns: 1fr;
      grid-template-areas: 'x' 'arrow' 'y' 'mod' 'z';
      row-gap: 0.5rem;
    }
    .arrow { height: 2rem; width: 100%; place-items: center; }
    .arrow::before { left: 50%; right: auto; top: 0.1rem; bottom: 0.5rem; border-top: 0; border-left: 1px solid var(--text); }
    .arrow::after { left: calc(50% - 4px); right: auto; top: auto; bottom: 0.1rem; border: 4px solid transparent; border-top: 7px solid var(--text); border-bottom: 0; }
    .arrow span { margin-left: 5rem; }
    .mod { margin-top: 0; }
    .g { width: 100%; }
    .dash { display: none; }
    .mod { margin-bottom: 0; }
  }
</style>
