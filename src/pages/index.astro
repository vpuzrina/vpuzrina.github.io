---
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/Figure.astro';
import PaperList from '../components/PaperList.astro';
import ExperienceList from '../components/ExperienceList.astro';
import LinkRow from '../components/LinkRow.astro';
import EventStudy from '../figures/EventStudy/EventStudy';
import { FIG1_PARAMS, FIG1_TAG } from '../figures/EventStudy/meta';
import { person, availability, experience, otherWork } from '../data/site';
import { u } from '../lib/url';
---
<BaseLayout
  title={person.name}
  description="Varvara Puzrina, Computer Science and Economics at Boston University, class of 2028. Research assistant on an NBER project and a BU economic history project. Looking for 2027 internships in economic consulting, research analytics and due diligence."
  footerContact={false}
>
  <div class="wrap">
    <section class="hero prose" aria-labelledby="hero-title">
      <h1 id="hero-title">{person.name}</h1>
      <p>
        I'm a junior at Boston University in the joint Computer Science and Economics program, class of 2028.
      </p>
      <p>
        I work as a research assistant on two economic history projects. On an NBER project about racial expulsions in the
        1880s, I have classified 5,000+ newspaper articles. On a BU project about mortality in Imperial Russia, I digitize
        archive tables and check that they add up. On my own, I am running an event study of the Cobre Panamá mine closure.
      </p>
      <p>{availability.sentence}</p>
      <p class="loc mono muted">{availability.location}</p>
      <LinkRow />
    </section>

    <Figure n={1} title="Event study of a one-day shock" tag={FIG1_TAG} params={FIG1_PARAMS} id="fig-1">
      <EventStudy client:visible id="fig1" source={{ kind: 'sim' }} />
      <Fragment slot="caption">
        <p>
          The line is the cumulative abnormal return of a simulated firm, summed from day −10, with a 95% band. The table
          gives the CAR over the event window, with SE(CAR) = <span class="hat">σ</span>·√L, which ignores the estimation error in <span class="hat">α</span> and <span class="hat tall">β</span>. Drag
          the event window and watch the t‑stat. The returns are simulated; the Cobre Panamá paper uses real prices.
        </p>
        <p><a class="more" href={u('/event-study-lab/')}>Open the full version →</a></p>
      </Fragment>
    </Figure>

    <section class="section" id="contents" aria-labelledby="contents-title">
      <h2 id="contents-title">Contents</h2>
      <PaperList />
    </section>

    <section class="section" id="experience" aria-labelledby="xp-title">
      <h2 id="xp-title">Experience</h2>
      <ExperienceList items={experience} />
      <ul class="onward more">
        <li><a href={u('/about/')}>Every role in full, with education and coursework →</a></li>
        <li><a href={u('/cv/')}>The one-page CV →</a></li>
      </ul>
    </section>

    <section class="section" id="other" aria-labelledby="other-title">
      <h2 id="other-title">Other work</h2>
      <ExperienceList items={otherWork} />
    </section>

    <section class="section" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <p class="prose">{availability.sentence} Email is the fastest way to reach me.</p>
      <LinkRow />
    </section>
  </div>
</BaseLayout>

<style>
  .hero { padding: var(--space-5) 0 var(--space-3); }
  .hero h1 { margin-bottom: var(--space-3); }
  .loc { margin-bottom: 0.6rem; }
  .onward { list-style: none; }
  .onward li { margin-bottom: 0.3rem; }
  @media (max-width: 719px) {
    .hero { padding-top: var(--space-4); }
  }
</style>
