---
// One-page CV. The PDF (/varvara-puzrina-cv.pdf, copied to /resume.pdf) is printed from this page
// by scripts/postbuild.mjs, so the two never drift apart. US Letter, checked to be one page.
import BaseLayout from '../layouts/BaseLayout.astro';
import Text from '../components/Text.astro';
import { person, availability } from '../data/site';
import { research, work, leadership, activities, educationDetail as ed, skills, certifications, type Entry } from '../data/about';
import { u } from '../lib/url';

const sections: [string, Entry[]][] = [
  ['Research experience', research],
  ['Professional experience', work],
];
const sk = Object.fromEntries(skills);
const cvSkills: [string, string][] = [
  ['Data and programming', `${sk['Analysis']}; Java (coursework)`],
  ['Languages', sk['Languages']],
];
---
<BaseLayout title="CV" description="One-page CV of Varvara Puzrina, Computer Science and Economics at Boston University, class of 2028. PDF version available.">
  <div class="wrap cv-page">
    <p class="cv-bar mono no-print">
      <span class="muted">One-page CV, US Letter.</span>
      <a href={u(person.cvPdf)} download="Varvara-Puzrina-CV.pdf">Download the PDF →</a>
    </p>

    <article class="cv">
      <header class="cv-head">
        <h1>{person.name}</h1>
        <p class="contact">
          {person.city} · <a href={`mailto:${person.email}`}>{person.email}</a> · <a href={person.linkedin}>{person.linkedinLabel}</a> ·{' '}
          <a href={person.github}>{person.githubLabel}</a> · <a href="https://vpuzrina.github.io">vpuzrina.github.io</a>
        </p>
        <p class="avail">{availability.sentence}</p>
      </header>

      <section>
        <h2>Education</h2>
        <div class="item">
          <p class="row"><strong>{ed.school}</strong><span>{ed.place}</span></p>
          <p class="row"><em>{ed.degree}{!ed.minor.includes('TODO') && `; ${ed.minor}`}</em><span>{ed.grad}</span></p>
          {ed.minor.includes('TODO') && <p class="line"><Text s={ed.minor} /></p>}
          <p class="line">Honors: {ed.honors}</p>
          <p class="line">Coursework: {ed.cvCoursework}</p>
        </div>
      </section>

      {sections.map(([title, items]) => (
        <section>
          <h2>{title}</h2>
          {items.filter((e) => !e.cvHide).map((e) => (
            <div class="item">
              <p class="row"><strong>{e.org}</strong><span>{e.place}</span></p>
              <p class="row"><em><Text s={e.cvRole ?? e.role} /></em><span><Text s={e.dates} /></span></p>
              <ul>{(e.cv ?? e.bullets).map((b) => <li><Text s={b} /></li>)}</ul>
            </div>
          ))}
        </section>
      ))}

      <section>
        <h2>Leadership and activities</h2>
        {leadership.filter((e) => !e.cvHide).map((e) => (
          <div class="item">
            <p class="row"><span class="l"><strong>{e.org}</strong>, <em><Text s={e.role} /></em></span><span><Text s={e.dates} /></span></p>
            <ul>{(e.cv ?? e.bullets).map((b) => <li><Text s={b} /></li>)}</ul>
          </div>
        ))}
        <p class="line"><strong>Activities:</strong> {activities}</p>
      </section>

      <section>
        <h2>Skills</h2>
        {cvSkills.map(([k, v]) => <p class="line"><strong>{k}:</strong> <Text s={v} /></p>)}
        <p class="line"><strong>{certifications.issuer}, {certifications.date}:</strong> {certifications.items}</p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .cv-page { padding-top: var(--space-4); }
  .cv-bar { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-bottom: var(--space-2); }
  .cv {
    max-width: 8.5in;
    border: 1px solid var(--rule);
    background: var(--surface);
    padding: 0.55in 0.6in;
    font-size: 0.9rem;
    line-height: 1.38;
  }
  .cv h1 { font-size: 1.6rem; text-align: center; margin: 0 0 0.25rem; letter-spacing: 0.01em; }
  .contact, .avail { text-align: center; margin: 0; font-size: 0.86em; }
  .avail { color: var(--muted); margin-top: 0.15rem; }
  .cv a { text-decoration-color: var(--rule); }
  .cv h2 {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--muted);
    padding-bottom: 0.1rem;
    margin: 0.85rem 0 0.35rem;
  }
  .item { margin-bottom: 0.4rem; }
  .row { display: flex; justify-content: space-between; gap: 1rem; margin: 0; }
  .row > span:last-child { white-space: nowrap; flex-shrink: 0; }
  .line { margin: 0; }
  .cv ul { margin: 0.1rem 0 0; padding-left: 1.05rem; }
  .cv li { margin: 0; }
  @media (max-width: 640px) {
    .cv { padding: 1rem; font-size: 0.85rem; }
    .row { flex-wrap: wrap; gap: 0 0.75rem; }
  }

  @media print {
    .cv-page { padding: 0; max-width: none; }
    .cv { border: 0; background: none; padding: 0; max-width: none; font-size: 9.4pt; line-height: 1.27; }
    .cv h1 { font-size: 17pt; }
    .cv h2 { font-size: 7.6pt; margin: 6pt 0 2.5pt; border-bottom-color: #000; }
    .avail { color: #333; }
    .item { margin-bottom: 3pt; break-inside: avoid; }
    .cv a::after { content: none !important; }
  }
</style>

<style is:global>
  @media print {
    @page { size: Letter; margin: 0.4in 0.5in; }
  }
</style>
