{
  "name": "vpuzrina-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-build.mjs && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "astro check",
    "validate": "html-validate \"dist/**/*.html\"",
    "check:links": "node tests/e2e/links.mjs",
    "check:contrast": "node tests/e2e/contrast.mjs",
    "check:a11y": "node tests/e2e/a11y.mjs",
    "check:net": "node tests/e2e/network-keyboard.mjs",
    "check:all": "npm test && npm run validate && npm run check:links && npm run check:contrast && npm run check:a11y && npm run check:net"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@capsizecss/metrics": "^4.4.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@types/node": "^22.20.5",
    "html-validate": "^11.18.0",
    "lighthouse": "^13.6.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/preact": "^6.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5",
    "preact": "^11.1.1"
  }
}
